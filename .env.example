# PostgreSQL connection string. Vercel injects this automatically after the
# project is connected to the rally-postgres integration.
RALLY_POSTGRES_URL="postgresql://user:password@host:5432/rally?sslmode=require"

# Auth0 Regular Web Application (keep real values in .env.local only).
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_CLIENT_ID="your-client-id"
AUTH0_CLIENT_SECRET="your-client-secret"
AUTH0_SECRET="generate-with-openssl-rand-hex-32"
APP_BASE_URL="http://localhost:4317"
# Override only if your Auth0 connections use custom names.
AUTH0_GOOGLE_CONNECTION="google-oauth2"
AUTH0_MICROSOFT_CONNECTION="windowslive"

# Gemini stays server-side; never prefix this variable with NEXT_PUBLIC_.
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.6-flash"

# Optional: set BOTH values when using your own tile provider.
# NEXT_PUBLIC_MAP_TILE_URL="https://your-provider/{z}/{x}/{y}.png"
# NEXT_PUBLIC_MAP_ATTRIBUTION="Your provider attribution"
